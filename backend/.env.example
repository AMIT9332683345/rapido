# Runtime
NODE_ENV=development
PORT=5000
# Optional branding override; omit to use ../brand.json
APP_NAME=Flash

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/smart_xerox?retryWrites=true&w=majority

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (comma separated)
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=
PUBLIC_BASE_URL=http://localhost:5000

# Admin bootstrap. No admin exists until these are set; never ship a default password.
ADMIN_NAME=Admin
ADMIN_MOBILE=9876543210
ADMIN_PASSWORD=set-a-strong-password

# Routing - point at your self-hosted OSRM in production.
# Development default uses the public OSRM demo server. Never use the demo server in production.
OSRM_BASE_URL=https://router.project-osrm.org
# When true, a straight-line estimate is used if OSRM is unreachable. Keep false in production.
ROUTING_ALLOW_ESTIMATE=false

# Matching
RIDE_REQUEST_RADIUS_KM=6
BOOKING_OFFER_SECONDS=60
BOOKING_SEARCH_MINUTES=4
RIDE_REQUEST_MAX_ROUNDS=6

# OSM services (Nominatim requires a descriptive User-Agent)
OSM_USER_AGENT=FlashRide/1.0

# Support details shown in the apps
SUPPORT_PHONE=
SUPPORT_EMAIL=

# Uploads (local disk). Use a persistent volume on Render.
UPLOAD_DIR=uploads

# Optional: expose self-hosted vector map details to the frontend config endpoint
MAP_PMTILES_URL=
MAP_STYLE_URL=

# Optional Firebase Cloud Messaging (HTTP v1) - background push
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
