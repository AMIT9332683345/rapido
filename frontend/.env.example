# API and realtime backend
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Brand (optional override; blank uses ../brand.json)
VITE_APP_NAME=
VITE_APP_TAGLINE=Bike rides across Gosaba

# Map style - free OpenStreetMap vector style, no API key.
# Replace with your own style JSON URL or leave the default.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional self-hosted PMTiles archive. When set, the app uses this instead of VITE_MAP_STYLE_URL.
VITE_MAP_PMTILES_URL=

# Service area map centre
VITE_CENTER_LAT=22.2167
VITE_CENTER_LNG=88.9000

# Optional Firebase web push configuration (requires matching FCM_* values in the backend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
